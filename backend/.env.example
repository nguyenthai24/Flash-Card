NODE_ENV=development

APP_NAME=flash-card-api
PORT=3000
FRONTEND_URL=http://localhost:3010
API_URL=http://localhost:3000/api
# Set to a shared parent domain when frontend and API use different subdomains.
COOKIE_DOMAIN=

MONGODB_URI=mongodb://localhost:27017/flash-card

JWT_SECRET=your-super-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-characters
JWT_EXPIRES_IN=15m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Resend (leave blank until configured)
RESEND_API_KEY=
RESEND_FROM=FlashCard <no-reply@example.com>

# OAuth callback URLs must match each provider's console configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/oauth/facebook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/oauth/github/callback